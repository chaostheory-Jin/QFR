XERO_CLIENT_ID=your_xero_client_id
XERO_CLIENT_SECRET=your_xero_client_secret
XERO_REDIRECT_URI=http://localhost:51789/callback
XERO_TENANT_ID=

# QuickBooks Online sandbox connector (separate from the Xero pipeline).
QUICKBOOKS_CLIENT_ID=your_quickbooks_development_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_development_client_secret
QUICKBOOKS_REDIRECT_URI=http://localhost:51790/callback
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_MINOR_VERSION=75
# Optional: login_quickbooks.py stores the selected realm ID in its token file.
# QUICKBOOKS_REALM_ID=

# Primary AI mapping key (preferred), with OPENAI_API_KEY as a fallback.
OPENAI_API_KEY_QFR=your_openai_key
# OPENAI_API_KEY=your_openai_key
# Optional invoice extractor model, set in frontend/.env.local.
# OPENAI_RECONCILIATION_MODEL=gpt-6-astra
# High-precision extraction is slower and uses more image tokens than mapping.
# OPENAI_RECONCILIATION_REASONING_EFFORT=high

# Mapping concurrency and per-request timeout defaults.
AI_MAPPING_WORKERS=4
OPENAI_TIMEOUT_SECONDS=30

# Optional legacy mapper; run_mvp.py does not use Gemini.
# GEMINI_API_KEY=your_gemini_key

# Frontend review persistence: set this in frontend/.env.local for the Next.js server.
# Local default: output/reviews (when running from frontend/).
# Production requires durable storage; do not use a serverless temporary directory.
# QFR_REVIEW_STORE_DIR=/absolute/path/to/durable/reviews

# CSV/Excel originals, import snapshots and invoice reconciliation decisions.
# Configure in frontend/.env.local; local default is output/data-platform.
# Requires a persistent/shared volume; production serverless needs a database/object store.
# QFR_DATA_STORE_DIR=/absolute/path/to/durable/data-platform
